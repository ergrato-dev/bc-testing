{
  "semana": "32",
  "titulo": "Fundamentos de Testing en Go",
  "checks": [
    {
      "id": "go-vet",
      "descripcion": "go vet no encuentra problemas",
      "cmd": "cd {proyecto}/go && go vet ./...",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 1 y 7"
    },
    {
      "id": "go-suite",
      "descripcion": "La suite Go pasa con -count=1 y en orden aleatorio",
      "cmd": "cd {proyecto}/go && go test -count=1 -shuffle=on ./...",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 7"
    },
    {
      "id": "no-skip",
      "descripcion": "No queda ningún t.Skip en los tests",
      "cmd": "test -d {proyecto}/go && ! grep -rq --include='*_test.go' 't.Skip' {proyecto}/go",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 3 y 4"
    },
    {
      "id": "tables",
      "descripcion": "Al menos 3 table-driven tests con t.Run",
      "cmd": "grep -rh --include='*_test.go' 't.Run(' {proyecto}/go | wc -l",
      "assert": "stdout~^([3-9]|[1-9][0-9]+)$",
      "pista": "3-proyecto/README.md, pasos 3 y 4"
    },
    {
      "id": "subtests",
      "descripcion": "Al menos 15 subtests que pasan",
      "cmd": "cd {proyecto}/go && go test -count=1 -v ./... | grep -cE -- '--- PASS: [^ ]+/'",
      "assert": "stdout~^([2-9][0-9]|1[5-9]|[1-9][0-9]{2,})$",
      "pista": "3-proyecto/README.md, pasos 3 y 4"
    },
    {
      "id": "parallel",
      "descripcion": "Los subtests de una tabla se ejecutan con t.Parallel",
      "cmd": "grep -rq --include='*_test.go' 't.Parallel()' {proyecto}/go",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 4"
    },
    {
      "id": "black-box",
      "descripcion": "Hay tests de caja negra (package x_test)",
      "cmd": "grep -rqE --include='*_test.go' '^package [a-z0-9_]+_test$' {proyecto}/go",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 5"
    },
    {
      "id": "examples",
      "descripcion": "Al menos 2 examples que se ejecutan y pasan",
      "cmd": "cd {proyecto}/go && go test -count=1 -v -run '^Example' ./... | grep -c -- '--- PASS: Example'",
      "assert": "stdout~^([2-9]|[1-9][0-9]+)$",
      "pista": "3-proyecto/README.md, paso 5"
    },
    {
      "id": "comparativa",
      "descripcion": "comparativa.md compara Jest, pytest, JUnit y Go, sin TODO",
      "cmd": "f={proyecto}/go/comparativa.md; test -f $f && grep -q Jest $f && grep -q pytest $f && grep -q JUnit $f && ! grep -q TODO $f",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 6"
    }
  ]
}
