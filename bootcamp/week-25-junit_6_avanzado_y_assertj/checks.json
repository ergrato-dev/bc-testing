{
  "semana": "25",
  "titulo": "JUnit 6 Avanzado y AssertJ",
  "checks": [
    {
      "id": "java-suite",
      "descripcion": "La suite Java pasa con mvn test",
      "cmd": "cd {proyecto}/java && mvn -q test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 1 y 2"
    },
    {
      "id": "no-disabled",
      "descripcion": "No queda ningún @Disabled en src/test",
      "cmd": "test -d {proyecto}/java/src/test && ! grep -rq '@Disabled' {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 3"
    },
    {
      "id": "test-count",
      "descripcion": "Al menos 15 ejecuciones de test, sin fallos ni saltados",
      "cmd": "cd {proyecto}/java && mvn test | grep 'Tests run:' | tail -1",
      "assert": "stdout~Tests run: ([2-9][0-9]|1[5-9]|[1-9][0-9]{2,}), Failures: 0, Errors: 0, Skipped: 0$",
      "pista": "3-proyecto/README.md, pasos 3 y 4"
    },
    {
      "id": "parameterized",
      "descripcion": "Al menos 3 tests parametrizados",
      "cmd": "grep -rh '^ *@ParameterizedTest' {proyecto}/java/src/test | wc -l",
      "assert": "stdout~^([3-9]|[1-9][0-9]+)$",
      "pista": "3-proyecto/README.md, paso 4"
    },
    {
      "id": "nested",
      "descripcion": "Al menos 2 contextos @Nested",
      "cmd": "grep -rh '^ *@Nested' {proyecto}/java/src/test | wc -l",
      "assert": "stdout~^([2-9]|[1-9][0-9]+)$",
      "pista": "3-proyecto/README.md, paso 3"
    },
    {
      "id": "soft-assertions",
      "descripcion": "Usa soft assertions de AssertJ",
      "cmd": "grep -rqE 'assertSoftly[(]|@InjectSoftAssertions' {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 5"
    },
    {
      "id": "assertj-only",
      "descripcion": "Las aserciones son de AssertJ, no de org.junit.jupiter.api.Assertions",
      "cmd": "test -d {proyecto}/java/src/test && ! grep -rq 'org.junit.jupiter.api.Assertions' {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 5"
    }
  ]
}
