<configuration>
  <!-- Una línea por evento, sin fecha: lo justo para ver qué contenedor arranca y cuánto tarda -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%-5level %logger - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
  <!-- tc.<imagen> es el logger de cada contenedor: "Creating container", "Container ... started" -->
  <logger name="tc" level="INFO"/>
</configuration>
