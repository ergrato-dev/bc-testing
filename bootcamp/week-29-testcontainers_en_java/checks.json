{
  "semana": "29",
  "titulo": "Testcontainers en Java",
  "checks": [
    {
      "id": "java-suite",
      "descripcion": "La suite Java pasa con mvn test (necesita Docker)",
      "cmd": "cd {proyecto}/java && mvn -q test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 1 a 7"
    },
    {
      "id": "flyway-migration",
      "descripcion": "Hay al menos una migración de Flyway en src/main/resources/db/migration",
      "cmd": "ls {proyecto}/java/src/main/resources/db/migration/V1__*.sql",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 3"
    },
    {
      "id": "jdbc-repositories",
      "descripcion": "Los repositorios de producción usan JdbcClient y ninguno guarda en memoria",
      "cmd": "grep -rlq 'JdbcClient' {proyecto}/java/src/main/java && ! grep -rq 'InMemory' {proyecto}/java/src/main",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 4"
    },
    {
      "id": "service-connection",
      "descripcion": "Los tests conectan PostgreSQL con @ServiceConnection",
      "cmd": "grep -rq '@ServiceConnection' {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 1 y 2"
    },
    {
      "id": "same-image",
      "descripcion": "Los tests usan la misma imagen de PostgreSQL que compose.yaml",
      "cmd": "img=$(grep -oE 'postgres:[0-9][0-9.]*-alpine' {proyecto}/compose.yaml | head -1) && test -n \"$img\" && grep -rqF \"$img\" {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 1"
    },
    {
      "id": "no-h2",
      "descripcion": "El pom.xml no usa H2",
      "cmd": "! grep -q 'h2database' {proyecto}/java/pom.xml",
      "assert": "exit0",
      "pista": "1-teoria/01-testcontainers-y-el-ciclo-de-vida.md, ¿Y H2?"
    },
    {
      "id": "contract-tests",
      "descripcion": "Hay tests de contrato que comparten el fake en memoria y el repositorio JDBC",
      "cmd": "grep -rlq 'abstract class .*Contract' {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 5 y 6"
    },
    {
      "id": "arch-rules",
      "descripcion": "La suite tiene al menos 5 reglas @ArchTest",
      "cmd": "grep -rhow '@ArchTest' {proyecto}/java/src/test | wc -l",
      "assert": "stdout~^([5-9]|[1-9][0-9]+)$",
      "pista": "3-proyecto/README.md, paso 7"
    },
    {
      "id": "no-disabled",
      "descripcion": "No queda ningún @Disabled en src/test",
      "cmd": "test -d {proyecto}/java/src/test && ! grep -rq '@Disabled' {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 5 a 7"
    },
    {
      "id": "test-count",
      "descripcion": "Al menos 85 ejecuciones de test, sin fallos ni saltados",
      "cmd": "cd {proyecto}/java && mvn test | grep 'Tests run:' | tail -1",
      "assert": "stdout~Tests run: (8[5-9]|9[0-9]|[1-9][0-9]{2,}), Failures: 0, Errors: 0, Skipped: 0$",
      "pista": "3-proyecto/README.md, paso 7"
    }
  ]
}
