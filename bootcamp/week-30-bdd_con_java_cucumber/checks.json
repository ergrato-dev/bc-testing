{
  "semana": "30",
  "titulo": "BDD con Java — Cucumber",
  "checks": [
    {
      "id": "java-suite",
      "descripcion": "La suite Java pasa con mvn test (necesita Docker)",
      "cmd": "cd {proyecto}/java && mvn -q test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 1 a 8"
    },
    {
      "id": "three-features",
      "descripcion": "Hay al menos 3 archivos .feature en src/test/resources",
      "cmd": "find {proyecto}/java/src/test/resources -name '*.feature' | wc -l",
      "assert": "stdout~^([3-9]|[1-9][0-9]+)$",
      "pista": "3-proyecto/README.md, pasos 3, 4 y 5"
    },
    {
      "id": "spanish-gherkin",
      "descripcion": "Todos los features están escritos en español (# language: es)",
      "cmd": "find {proyecto}/java/src/test/resources -name '*.feature' | xargs grep -L '^# language: es'",
      "assert": "stdout!~[.]feature",
      "pista": "1-teoria/01-cucumber-en-java.md, Gherkin en español"
    },
    {
      "id": "suite-runner",
      "descripcion": "Una clase @Suite ejecuta el motor de Cucumber",
      "cmd": "grep -rq 'IncludeEngines[(]\"cucumber\"[)]' {proyecto}/java/src/test/java",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 1"
    },
    {
      "id": "cucumber-spring",
      "descripcion": "Los escenarios arrancan Spring Boot con @CucumberContextConfiguration",
      "cmd": "grep -rq '@CucumberContextConfiguration' {proyecto}/java/src/test/java",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 1"
    },
    {
      "id": "scenario-scope",
      "descripcion": "Las clases de steps comparten estado con un bean @ScenarioScope",
      "cmd": "grep -rq '@ScenarioScope' {proyecto}/java/src/test/java",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 1 y 3"
    },
    {
      "id": "data-tables",
      "descripcion": "Los steps convierten tablas con @DataTableType",
      "cmd": "grep -rq '@DataTableType' {proyecto}/java/src/test/java",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 3"
    },
    {
      "id": "scenario-outline",
      "descripcion": "Al menos un feature usa Esquema del escenario con Ejemplos",
      "cmd": "grep -rq 'Esquema del escenario' {proyecto}/java/src/test/resources",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 3"
    },
    {
      "id": "reports",
      "descripcion": "mvn test deja el reporte HTML y el JSON de Cucumber en target/cucumber-reports",
      "cmd": "test -s {proyecto}/java/target/cucumber-reports/cucumber.html && test -s {proyecto}/java/target/cucumber-reports/cucumber.json",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 1 y 7"
    },
    {
      "id": "scenario-count",
      "descripcion": "Al menos 12 escenarios ejecutados (los ejemplos de cada esquema cuentan)",
      "cmd": "grep -o '\"type\":\"scenario\"' {proyecto}/java/target/cucumber-reports/cucumber.json | wc -l",
      "assert": "stdout~^(1[2-9]|[2-9][0-9]|[1-9][0-9]{2,})$",
      "pista": "3-proyecto/README.md, pasos 3 a 5"
    },
    {
      "id": "no-disabled",
      "descripcion": "No queda ningún @Disabled en src/test",
      "cmd": "test -d {proyecto}/java/src/test && ! grep -rq '@Disabled' {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 8"
    },
    {
      "id": "test-count",
      "descripcion": "Al menos 100 ejecuciones de test, sin fallos ni saltados",
      "cmd": "cd {proyecto}/java && mvn test | grep 'Tests run:' | tail -1",
      "assert": "stdout~Tests run: ([1-9][0-9]{2,}), Failures: 0, Errors: 0, Skipped: 0$",
      "pista": "3-proyecto/README.md, paso 8"
    }
  ]
}
