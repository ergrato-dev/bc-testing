<configuration>
  <!-- Solo avisos y errores: la salida de Cucumber se lee sin el registro de arranque de Spring -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%-5level %logger - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
