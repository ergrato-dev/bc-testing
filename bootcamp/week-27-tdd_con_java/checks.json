{
  "semana": "27",
  "titulo": "TDD con Java",
  "checks": [
    {
      "id": "java-suite",
      "descripcion": "La suite Java pasa con mvn test",
      "cmd": "cd {proyecto}/java && mvn -q test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 3 y 4"
    },
    {
      "id": "archunit",
      "descripcion": "El pom.xml incluye ArchUnit",
      "cmd": "grep -q '<artifactId>archunit-junit5</artifactId>' {proyecto}/java/pom.xml",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 1"
    },
    {
      "id": "arch-rules",
      "descripcion": "La suite tiene al menos 3 reglas @ArchTest",
      "cmd": "grep -rhow '@ArchTest' {proyecto}/java/src/test | wc -l",
      "assert": "stdout~^([3-9]|[1-9][0-9]+)$",
      "pista": "3-proyecto/README.md, paso 1"
    },
    {
      "id": "clock",
      "descripcion": "El código de producción recibe la fecha por un Clock",
      "cmd": "grep -rqw 'Clock' {proyecto}/java/src/main",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 2"
    },
    {
      "id": "no-disabled",
      "descripcion": "No queda ningún @Disabled en src/test",
      "cmd": "test -d {proyecto}/java/src/test && ! grep -rq '@Disabled' {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 3"
    },
    {
      "id": "test-count",
      "descripcion": "Al menos 35 ejecuciones de test, sin fallos ni saltados",
      "cmd": "cd {proyecto}/java && mvn test | grep 'Tests run:' | tail -1",
      "assert": "stdout~Tests run: ([4-9][0-9]|3[5-9]|[1-9][0-9]{2,}), Failures: 0, Errors: 0, Skipped: 0$",
      "pista": "3-proyecto/README.md, paso 3"
    },
    {
      "id": "tdd-log",
      "descripcion": "TDD-LOG.md registra al menos 15 ciclos",
      "cmd": "grep -cE '^[|] *[0-9]+ *[|]' {proyecto}/java/TDD-LOG.md",
      "assert": "stdout~^(1[5-9]|[2-9][0-9]|[1-9][0-9]{2,})$",
      "pista": "3-proyecto/README.md, paso 3"
    }
  ]
}
