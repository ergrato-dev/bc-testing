{
  "semana": "33",
  "titulo": "Interfaces y Dobles de Prueba en Go",
  "checks": [
    {
      "id": "go-vet",
      "descripcion": "go vet no encuentra problemas",
      "cmd": "cd {proyecto}/go && go vet ./...",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 8"
    },
    {
      "id": "go-suite",
      "descripcion": "La suite Go pasa con -count=1 y en orden aleatorio",
      "cmd": "cd {proyecto}/go && go test -count=1 -shuffle=on ./...",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 8"
    },
    {
      "id": "no-skip",
      "descripcion": "No queda ningún t.Skip en los tests",
      "cmd": "test -d {proyecto}/go && ! grep -rq --include='*_test.go' 't.Skip' {proyecto}/go",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 4 a 6"
    },
    {
      "id": "clock",
      "descripcion": "El código de producción no llama a time.Now(): el reloj se inyecta",
      "cmd": "test -d {proyecto}/go && ! grep -rq --include='*.go' --exclude='*_test.go' 'time[.]Now[(][)]' {proyecto}/go",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 3"
    },
    {
      "id": "fake",
      "descripcion": "Hay al menos un fake escrito a mano (type fakeXxx)",
      "cmd": "grep -rqE --include='*_test.go' '^type fake[A-Z][A-Za-z0-9]* ' {proyecto}/go",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 4"
    },
    {
      "id": "mockgen-tool",
      "descripcion": "mockgen está registrado como herramienta en go.mod",
      "cmd": "grep -q '^tool go.uber.org/mock/mockgen' {proyecto}/go/go.mod",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 5"
    },
    {
      "id": "go-generate",
      "descripcion": "El mock se genera con una directiva //go:generate",
      "cmd": "grep -rq --include='*.go' '^//go:generate go tool mockgen' {proyecto}/go",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 5"
    },
    {
      "id": "mock",
      "descripcion": "Hay un mock generado por mockgen y los tests lo usan con EXPECT()",
      "cmd": "grep -rq --include='*.go' '^// Code generated by MockGen' {proyecto}/go && grep -rq --include='*_test.go' '[.]EXPECT[(][)][.]' {proyecto}/go",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 5"
    },
    {
      "id": "cmp-diff",
      "descripcion": "Los tests comparan estructuras con cmp.Diff",
      "cmd": "grep -rq --include='*_test.go' 'cmp[.]Diff[(]' {proyecto}/go",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 4"
    },
    {
      "id": "golden",
      "descripcion": "Hay al menos un golden file en testdata/ y un flag -update",
      "cmd": "find {proyecto}/go -path '*/testdata/*.golden' | grep -q . && grep -rq --include='*_test.go' 'flag[.]Bool[(].update.' {proyecto}/go",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 6"
    },
    {
      "id": "dobles",
      "descripcion": "dobles.md justifica cada doble (fake y mock), sin TODO",
      "cmd": "f={proyecto}/go/dobles.md; test -f $f && grep -qi fake $f && grep -qi mock $f && ! grep -q TODO $f",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 7"
    }
  ]
}
