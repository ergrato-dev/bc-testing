{
  "semana": "37",
  "titulo": "Fundamentos de Testing en Rust",
  "checks": [
    {
      "id": "cargo-test",
      "descripcion": "cargo test pasa: unitarios, integración y doctests",
      "cmd": "cd {proyecto}/rust && cargo test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 8"
    },
    {
      "id": "no-warnings",
      "descripcion": "cargo test compila sin warnings (ningún test sin #[test])",
      "cmd": "cd {proyecto}/rust && cargo test --no-run 2>&1 | grep -c '^warning'",
      "assert": "stdout~^0$",
      "pista": "3-proyecto/README.md, paso 8"
    },
    {
      "id": "no-ignore",
      "descripcion": "No queda ningún #[ignore] en los tests",
      "cmd": "test -d {proyecto}/rust && ! grep -rqF --include='*.rs' '#[ignore' {proyecto}/rust",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 3 y 4"
    },
    {
      "id": "unit-tests",
      "descripcion": "Al menos 15 tests unitarios que pasan",
      "cmd": "cd {proyecto}/rust && cargo test --lib 2>&1 | grep -cE '^test .* [.]{3} ok$'",
      "assert": "stdout~^(1[5-9]|[2-9][0-9]|[1-9][0-9]{2,})$",
      "pista": "3-proyecto/README.md, pasos 3 y 4"
    },
    {
      "id": "result-test",
      "descripcion": "Al menos un test devuelve Result y usa ?",
      "cmd": "grep -rqE --include='*.rs' 'fn [a-z0-9_]+[(][)] -> Result<' {proyecto}/rust",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 4"
    },
    {
      "id": "integration",
      "descripcion": "Al menos 2 tests de integración en tests/ que pasan",
      "cmd": "cd {proyecto}/rust && cargo test --test '*' 2>&1 | grep -cE '^test .* [.]{3} ok$'",
      "assert": "stdout~^([2-9]|[1-9][0-9]+)$",
      "pista": "3-proyecto/README.md, paso 5"
    },
    {
      "id": "pretty-assertions",
      "descripcion": "Los tests usan el assert_eq! de pretty_assertions",
      "cmd": "grep -rqF --include='*.rs' 'use pretty_assertions::assert_eq' {proyecto}/rust",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 5"
    },
    {
      "id": "doctests",
      "descripcion": "Al menos 2 doctests que pasan",
      "cmd": "cd {proyecto}/rust && cargo test --doc 2>&1 | grep -cE ' - .* [.]{3} ok$'",
      "assert": "stdout~^([2-9]|[1-9][0-9]+)$",
      "pista": "3-proyecto/README.md, paso 6"
    },
    {
      "id": "comparativa",
      "descripcion": "comparativa.md compara Go y Rust, sin TODO",
      "cmd": "f={proyecto}/rust/comparativa.md; test -f $f && grep -q Go $f && grep -q Rust $f && ! grep -q TODO $f",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 7"
    }
  ]
}
