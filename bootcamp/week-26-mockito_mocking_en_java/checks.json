{
  "semana": "26",
  "titulo": "Mockito — Mocking en Java",
  "checks": [
    {
      "id": "java-suite",
      "descripcion": "La suite Java pasa con mvn test",
      "cmd": "cd {proyecto}/java && mvn -q test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, pasos 2 y 3"
    },
    {
      "id": "mockito-agent",
      "descripcion": "El pom.xml carga Mockito como agente de Java",
      "cmd": "grep -q 'javaagent:${org.mockito:mockito-core:jar}' {proyecto}/java/pom.xml",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 1"
    },
    {
      "id": "no-disabled",
      "descripcion": "No queda ningún @Disabled en src/test",
      "cmd": "test -d {proyecto}/java/src/test && ! grep -rq '@Disabled' {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 4"
    },
    {
      "id": "test-count",
      "descripcion": "Al menos 20 ejecuciones de test, sin fallos ni saltados",
      "cmd": "cd {proyecto}/java && mvn test | grep 'Tests run:' | tail -1",
      "assert": "stdout~Tests run: ([2-9][0-9]|[1-9][0-9]{2,}), Failures: 0, Errors: 0, Skipped: 0$",
      "pista": "3-proyecto/README.md, paso 4"
    },
    {
      "id": "mocks",
      "descripcion": "Al menos 3 dependencias sustituidas con @Mock",
      "cmd": "grep -rhow '@Mock' {proyecto}/java/src/test | wc -l",
      "assert": "stdout~^([3-9]|[1-9][0-9]+)$",
      "pista": "3-proyecto/README.md, paso 4"
    },
    {
      "id": "mockito-extension",
      "descripcion": "Los mocks los crea MockitoExtension",
      "cmd": "grep -rq 'MockitoExtension' {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 4"
    },
    {
      "id": "verify",
      "descripcion": "La suite verifica interacciones con verify o then().should()",
      "cmd": "grep -rqE 'verify[(]|should[(]' {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 4"
    },
    {
      "id": "captor",
      "descripcion": "La suite captura argumentos con ArgumentCaptor",
      "cmd": "grep -rqE 'ArgumentCaptor|@Captor' {proyecto}/java/src/test",
      "assert": "exit0",
      "pista": "3-proyecto/README.md, paso 4"
    }
  ]
}
